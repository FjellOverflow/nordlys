---
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import PagefindPlugin from '@/plugins/PagefindPlugin.astro'

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: 'Search'
}
---

<PageLayout {frontmatter}>
  <h1>{frontmatter.title}</h1>
  <search-input class="flex w-full items-center justify-center gap-8">
    <input
      type="text"
      placeholder="Type to search"
      class="border-accent w-full rounded-sm border p-4 sm:w-[50%]"
    />
    <button id="search-clear" class="clickable invisible text-xl">
      Clear
    </button>
  </search-input>
  <h2 id="results-heading">Type to search</h2>
  <ul id="results-list" class="list-none p-0"></ul>

  <PagefindPlugin />
</PageLayout>

<script>
  interface PagefindResultData {
    url: string
    meta: { title: string }
    excerpt: string
  }

  interface PagefindResult {
    data: () => Promise<PagefindResultData>
  }

  const maxShownResults = 15

  const renderResult = ({ url, meta, excerpt }: PagefindResultData) => {
    const li = document.createElement('li')

    const a = document.createElement('a')
    a.className = 'text-xl font-normal'
    a.href = url
    a.textContent = meta.title

    const div = document.createElement('div')
    div.className = 'opacity-75 mt-4'
    const escapedExcerpt = document.createElement('div')
    escapedExcerpt.textContent = excerpt
    div.innerHTML = escapedExcerpt.innerHTML.replace(
      /&lt;mark&gt;(.*?)&lt;\/mark&gt;/g,
      '<mark>$1</mark>'
    )

    li.appendChild(a)
    li.appendChild(div)

    return li
  }

  class SearchInput extends HTMLElement {
    async connectedCallback() {
      const searchInput = this.querySelector('input')
      const clearBtn = this.querySelector('button')

      const resultsHeading = document.querySelector('#results-heading')
      const resultsContainer = document.querySelector('#results-list')

      if (!searchInput || !clearBtn || !resultsHeading || !resultsContainer)
        return

      let latestSearchId = 0

      const onInput = async () => {
        const searchQuery = searchInput.value
        const searchId = ++latestSearchId

        if (searchQuery === '') clearBtn.classList.add('invisible')
        else clearBtn.classList.remove('invisible')

        const { results } = await window.pagefind.search(searchQuery)

        const shownResults = await Promise.all(
          results
            .slice(0, maxShownResults)
            .map((r) => (r as PagefindResult).data())
        )

        if (searchId !== latestSearchId) return

        resultsHeading.innerHTML =
          results.length > 0 ? `Results (${results.length})` : 'No Results'

        resultsContainer.replaceChildren(...shownResults.map(renderResult))

        if (results.length > maxShownResults) {
          const remainingLi = document.createElement('li')
          remainingLi.innerHTML = `... and ${results.length - maxShownResults} more`
          resultsContainer.appendChild(remainingLi)
        }
      }

      searchInput.addEventListener('input', onInput)

      clearBtn.addEventListener('click', () => {
        searchInput.value = ''
        onInput()
      })
    }
  }

  if (!customElements.get('search-input'))
    customElements.define('search-input', SearchInput)
</script>
